{
  "name": "@dark-tower/workbench",
  "version": "0.0.0",
  "private": true,
  "description": "Shared read-only workbench: ID schemes, markdown with ID chips, card files, the focus graph and the prompt starter. Used by game-workbench and story-workbench.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./components": "./src/components/index.ts",
    "./styles/*": "./styles/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "marked": "18.0.14",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "29.1.1",
    "vitest": "5.0.4"
  }
}
