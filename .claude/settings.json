{
  "permissions": {
    "deny": ["Read(**/.env*)", "Edit(**/.env*)", "Write(**/.env*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")\"; node \"$d/.claude/hooks/protect-intent.mjs\""
          },
          {
            "type": "command",
            "command": "d=\"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")\"; node \"$d/.claude/hooks/pin-guard.mjs\""
          },
          {
            "type": "command",
            "command": "d=\"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")\"; node \"$d/.claude/hooks/test-lock.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")\"; node \"$d/.claude/hooks/no-main-commit.mjs\""
          },
          {
            "type": "command",
            "command": "d=\"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")\"; node \"$d/.claude/hooks/protect-intent.mjs\""
          },
          {
            "type": "command",
            "command": "d=\"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")\"; node \"$d/.claude/hooks/pin-guard.mjs\""
          },
          {
            "type": "command",
            "command": "d=\"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")\"; node \"$d/.claude/hooks/test-lock.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")\"; bash \"$d/.claude/hooks/format.sh\""
          }
        ]
      }
    ]
  }
}
