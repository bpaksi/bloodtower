{
  "name": "dark-tower",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for the Dark Tower apps. See README.md and docs/sdlc.md.",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "lefthook install",
    "check": "biome check . && pnpm check:repo && pnpm -r --if-present typecheck && pnpm -r --if-present test",
    "check:repo": "node scripts/check-pins.mjs && node scripts/check-imports.mjs && node --test \"scripts/*.test.mjs\" \".claude/hooks/*.test.mjs\"",
    "land": "node scripts/land.mjs",
    "build": "pnpm --filter \"./apps/*\" --if-present build",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.2.2",
    "typescript": "6.0.3"
  }
}
