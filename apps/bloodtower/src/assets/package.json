{
  "name": "bloodtower-assets",
  "version": "0.0.0",
  "private": true,
  "description": "Bloodtower asset adapter: reads a story pack and writes an asset-studio job (assets:needs).",
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "needs": "tsx needs/main.ts",
    "import": "tsx import/main.ts"
  },
  "dependencies": {
    "@asset-studio/cli": "0.2.2",
    "@asset-studio/formats": "0.2.2",
    "@asset-studio/player": "0.2.2",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "vitest": "5.0.4"
  }
}
