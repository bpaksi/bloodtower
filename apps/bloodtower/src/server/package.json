{
  "name": "bloodtower-server",
  "version": "0.0.0",
  "private": true,
  "description": "Node host for Bloodtower: static UI now; story loader, session, SQLite and the tower sidecar in later steps.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "tsx index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:lint": "tsx scripts/packLint.ts",
    "playtest": "tsx scripts/playtest.ts",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@dark-tower/tower": "workspace:*",
    "@stoprocent/noble": "2.8.0",
    "bloodtower-engine": "workspace:*",
    "better-sqlite3": "13.0.3",
    "bloodtower-protocols": "workspace:*",
    "drizzle-orm": "0.45.3",
    "qrcode": "1.5.4",
    "tsx": "4.23.15",
    "ultimatedarktower": "7.1.2",
    "ultimatedarktowerdata": "3.0.0",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "vitest": "5.0.4"
  }
}
